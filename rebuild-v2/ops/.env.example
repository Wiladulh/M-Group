# M-Group clean-room v2 server configuration.
# Set these values in the service environment or a root-readable secret file.
# The initial super-admin is created only when the v2 database has no admin users.
MGROUP_ADMIN_USERNAME=admin
MGROUP_ADMIN_PASSWORD=CHANGE-ME-TO-A-UNIQUE-12-TO-128-CHARACTER-PASSWORD
MGROUP_DEVICE_KEY_PEPPER=CHANGE-ME-TO-A-SEPARATE-RANDOM-SECRET
MGROUP_DB_PATH=/var/lib/M-Group-v2/mgroup-v2.sqlite3
