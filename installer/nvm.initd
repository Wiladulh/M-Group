#!/sbin/openrc-run
name="M-Group"
description="M-Group M-Group platform server"
command="/opt/M-Group/venv/bin/uvicorn"
command_args="app.main:app --host ${M-Group_HOST:-0.0.0.0} --port ${M-Group_PORT:-8011}"
command_user="${M-Group_USER:-root}"
directory="/opt/M-Group"
pidfile="/run/M-Group.pid"
command_background="yes"
output_log="/var/log/M-Group.log"
error_log="/var/log/M-Group.log"

depend() {
  need net
  after firewall
}

start_pre() {
  checkpath --directory --owner "${M-Group_USER:-root}" /var/lib/M-Group
  checkpath --file --owner "${M-Group_USER:-root}" /var/log/M-Group.log
}
