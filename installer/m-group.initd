#!/sbin/openrc-run
name="M-Group"
description="M-Group platform server"
command="/opt/M-Group/bin/m-group-server-openrc"
command_user="${M_GROUP_USER:-m-group}:${M_GROUP_USER:-m-group}"
directory="/opt/M-Group"
pidfile="/run/m-group.pid"
command_background="yes"
output_log="/var/log/m-group.log"
error_log="/var/log/m-group.log"

depend() {
  need net
  after firewall
}

start_pre() {
  checkpath --directory --owner "${M_GROUP_USER:-m-group}" /var/lib/M-Group
  checkpath --file --owner "${M_GROUP_USER:-m-group}" /var/log/m-group.log
}
